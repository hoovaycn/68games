    "newRight": "{ALLY_1_PORTRAIT}"
  },
  {
    "file": "story_chapter15.js",
    "sceneKey": "ch15_scene_beach_wake",
    "id": 5,
    "speaker": "{MC_NAME}",
    "text": "快看浅滩！几艘小帆船靠岸了，那些拿洋枪和刀的人正往销烟池边冲，要抢还没销毁的鸦片",
