    "newRight": "assets/art/teacher_xu_default@2x.png"
  },
  {
    "file": "story_chapter13.js",
    "sceneKey": "ch13_scene_dock_alert",
    "id": 3,
    "speaker": "老爸海峰",
    "text": "我已经把名单报给警方，请他们尽快联系家长。可省厅增援还要四十分钟，他们半小时后就",
