  {
    "file": "story_chapter15.js",
    "sceneKey": "ch15_scene_militia_stand",
    "id": 6,
    "speaker": "{ALLY_1_NAME}",
    "text": "大家靠过来，护住池边的鸦片箱！不能让他们把烟土抢回去！",
