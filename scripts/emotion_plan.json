    "oldRight": "assets/art/teacher_xu_default@2x.png",
    "newRight": "assets/art/teacher_xu_default@2x.png"
  },
  {
    "file": "story_chapter15.js",
    "sceneKey": "ch15_scene_militia_stand",
    "id": 11,
    "speaker": "虎门民团教头",
    "text": "我是这儿带民团守池的。林大人让我盯紧这些还没销毁的鸦片，不能让人抢走。你们几个从",
