    "oldRight": "{MC_PORTRAIT}",
    "newRight": "{MC_RESOLUTE_PORTRAIT}"
  },
  {
    "file": "story_chapter15.js",
    "sceneKey": "ch15_scene_militia_stand",
    "id": 12,
    "speaker": "{MC_NAME}",
    "text": "我们从海滩那头来的，看见他们要抢箱子。我们是来帮忙的，您说怎么守？",
    "oldLeft": "{MC_PORTRAIT}",
    "newLeft": "{MC_RESOLUTE_PORTRAIT}",
