    "oldRight": "{MC_PORTRAIT}",
    "newRight": "{MC_RESOLUTE_PORTRAIT}"
  },
  {
    "file": "story_chapter14.js",
    "sceneKey": "ch14_scene_pot_broken",
    "id": 4,
    "speaker": "{MC_NAME}",
    "text": "先捂住口鼻，别吸那股黑烟！它跟学校的怪味零食一样会让人失控。打手已经围上来了，大",
    "oldLeft": "{MC_PORTRAIT}",
    "newLeft": "{MC_RESOLUTE_PORTRAIT}",
